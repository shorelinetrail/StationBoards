{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "ADMIN_PASSWORD": "@admin-password",
    "RESEND_API_KEY": "@resend-api-key",
    "ROYAL_MAIL_API_KEY": "@royal-mail-api-key"
  }
}
